# Copiar a .env.local y completar con los valores reales — nunca commitear
# el archivo con los valores puestos, solo este ejemplo sin datos.

# Supabase — proyecto real de Odoo/Benserca 18.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Mismos valores, sin prefijo NEXT_PUBLIC_, para los scripts de Node
# (scripts/*.mjs, verificacion/*.mjs) que corren fuera del navegador.
SUPABASE_URL=
SUPABASE_ANON_KEY=
